{
   "$schema": "https://x.a1st.dev/schemas/v1/ai.json",
   "skills": {
      "new-repo-setup": {
         "path": "./skills/new-repo-setup/"
      },
      "learn": {
         "path": "./skills/learn/"
      },
      "app-store-readiness": {
         "path": "./skills/app-store-readiness/"
      },
      "write-app-store-copy": {
         "path": "./skills/write-app-store-copy/"
      },
      "mobile-game-patterns": {
         "path": "./skills/mobile-game-patterns/"
      }
   },
   "mcp": {
      "tauri": {
         "command": "npx",
         "args": [
            "@hypothesi/tauri-mcp-server"
         ]
      },
      "playwright": {
         "command": "npx",
         "args": [
            "@playwright/mcp"
         ]
      },
      "fallow": {
         "command": "npx",
         "args": [
            "-y",
            "-p",
            "fallow",
            "fallow-mcp"
         ]
      },
      "agent-device": {
         "command": "npx",
         "args": [
            "-y",
            "agent-device",
            "mcp"
         ]
      }
   },
   "rules": {
      "general": "./rules/general.md",
      "css-scss": "./rules/css-scss.md",
      "do-not": "./rules/do-not.md",
      "git": "./rules/git.md",
      "mcps": "./rules/mcps.md",
      "npm": "./rules/npm.md",
      "rust": "./rules/rust.md",
      "tauri": "./rules/tauri.md",
      "testing": "./rules/testing.md",
      "typescript-javascript": "./rules/typescript-javascript.md",
      "vue": "./rules/vue.md",
      "writing": "./rules/writing.md",
      "dependency-licenses": "./rules/dependency-licenses.md",
      "libraries": "./rules/libraries.md",
      "markdown": "./rules/markdown.md",
      "sql": "./rules/sql.md",
      "swift": "./rules/swift.md"
   },
   "prompts": {
      "plan": "./prompts/plan.md",
      "implement-plan": "./prompts/implement-plan.md",
      "rebase": "./prompts/rebase.md",
      "commit": "./prompts/commit.md",
      "justdoit": "./prompts/justdoit.md"
   },
   "hooks": {
      "agent_stop": [
         {
            "hooks": [
               {
                  "type": "command",
                  "command": "node ./hooks/check-prose.mjs"
               }
            ]
         }
      ],
      "subagent_stop": [
         {
            "hooks": [
               {
                  "type": "command",
                  "command": "node ./hooks/check-prose.mjs"
               }
            ]
         }
      ],
      "pre_tool_use": [
         {
            "matcher": "Bash|Write|Edit",
            "hooks": [
               {
                  "type": "command",
                  "command": "node ./hooks/check-prose.mjs"
               }
            ]
         }
      ]
   },
   "agents": {
      "app-store-readiness": "./agents/app-store-readiness.md",
      "write-app-store-copy": "./agents/write-app-store-copy.md"
   },
   "plugins": {},
   "marketplaces": {}
}
